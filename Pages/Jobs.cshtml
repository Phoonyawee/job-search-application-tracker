@page
@model JobsModel
@{
    ViewData["Title"] = "ค้นหางาน";
}

<header class="page-heading">
    <span class="eyebrow">จับคู่โอกาสกับทักษะ</span>
    <h1>ค้นหางานที่เหมาะกับคุณ</h1>
    <p>ตำแหน่งงานตัวอย่างถูกจัดอันดับจากทักษะใน Portfolio ของคุณ</p>
</header>

<form method="get" class="filter panel">
    <label>คำค้นหา<input asp-for="Keyword" placeholder="ชื่อตำแหน่ง บริษัท หรือทักษะ" /></label>
    <label>พื้นที่ทำงาน<select asp-for="Location"><option value="">ทุกพื้นที่</option>@foreach (var item in Model.Locations) { <option>@item</option> }</select></label>
    <label>คะแนนขั้นต่ำ<select asp-for="MinimumMatch"><option value="0">ทุกระดับ</option><option value="50">50% ขึ้นไป</option><option value="75">75% ขึ้นไป</option><option value="100">100%</option></select></label>
    <button class="button primary" type="submit">ค้นหางาน</button>
</form>

<div class="result-count">พบ @Model.Matches.Count ตำแหน่ง</div>
<section class="job-list">
@foreach (var match in Model.Matches)
{
    <article class="job-card">
        <div class="job-main">
            <div class="job-title"><div><h2>@match.Job.Title</h2><p>@match.Job.Company · @match.Job.Location · @match.Job.WorkMode</p></div><span class="match">ตรง @match.Score%</span></div>
            <p>@match.Job.Description</p>
            <div class="skill-list">@foreach (var skill in match.Job.RequiredSkills.Split(',')) { <span>@skill.Trim()</span> }</div>
            <div class="job-meta"><span>@match.Job.EmploymentType</span><span>@match.Job.SalaryRange</span><span>ประกาศเมื่อ @match.Job.PostedAt.ToString("dd/MM/yyyy")</span></div>
        </div>
        <form method="post" class="job-actions">
            <input type="hidden" name="jobId" value="@match.Job.Id" />
            @if (match.Status is null)
            {
                <button class="button secondary" name="status" value="Saved">บันทึกไว้</button>
                <button class="button primary" name="status" value="Applied">สมัครแล้ว</button>
            }
            else
            {
                <span class="status">@match.Status.Value.ToThai()</span>
                <a asp-page="/Applications">อัปเดตใบสมัคร →</a>
            }
        </form>
    </article>
}
</section>
