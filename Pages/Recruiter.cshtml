@page
@model RecruiterModel
@{
    ViewData["Title"] = "ฝ่ายสรรหา";
}

<header class="page-heading"><span class="eyebrow">RECRUITER</span><h1>จัดการฝ่ายสรรหา</h1><p>สร้างประกาศงาน เปิดหรือปิดรับสมัคร และตรวจสอบผู้สมัคร</p></header>

<section class="panel management-section">
    <h2>สร้างประกาศงาน</h2>
    <form method="post" asp-page-handler="Create" class="management-form">
        <div asp-validation-summary="All" class="text-danger wide"></div>
        <label>ชื่อตำแหน่ง<input asp-for="Input.Title" /></label>
        <label>บริษัท<input asp-for="Input.Company" /></label>
        <label>สถานที่<input asp-for="Input.Location" /></label>
        <label>รูปแบบงาน<input asp-for="Input.WorkMode" placeholder="เช่น ไฮบริด" /></label>
        <label>ประเภทการจ้าง<input asp-for="Input.EmploymentType" placeholder="เช่น เต็มเวลา" /></label>
        <label>ช่วงเงินเดือน<input asp-for="Input.SalaryRange" placeholder="เช่น ฿30,000–40,000" /></label>
        <label class="wide">ทักษะที่ต้องการ<input asp-for="Input.RequiredSkills" placeholder="C#, SQL, Git" /></label>
        <label class="wide">รายละเอียด<textarea asp-for="Input.Description" rows="3"></textarea></label>
        <button class="button primary" type="submit">เผยแพร่ตำแหน่งงาน</button>
    </form>
</section>

<section class="panel management-section">
    <h2>ประกาศงาน (@Model.Jobs.Count)</h2>
    <div class="table-wrap"><table><thead><tr><th>ตำแหน่ง</th><th>บริษัท</th><th>สถานะ</th><th></th></tr></thead><tbody>
    @foreach (var job in Model.Jobs)
    {
        <tr><td><strong>@job.Title</strong><small>@job.Location · @job.WorkMode</small></td><td>@job.Company</td><td><span class="status">@(job.IsActive ? "เปิดรับ" : "ปิดรับ")</span></td><td><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@job.Id" /><button class="button secondary" type="submit">@(job.IsActive ? "ปิดรับ" : "เปิดรับ")</button></form></td></tr>
    }
    </tbody></table></div>
</section>

<section class="panel management-section">
    <h2>ผู้สมัครทั้งหมด (@Model.Applications.Count)</h2>
    <div class="table-wrap"><table><thead><tr><th>ผู้สมัคร</th><th>ตำแหน่ง</th><th>สถานะ</th><th>อัปเดตล่าสุด</th></tr></thead><tbody>
    @foreach (var application in Model.Applications)
    {
        <tr><td>@Model.CandidateEmails.GetValueOrDefault(application.UserId, "ไม่ทราบอีเมล")</td><td>@application.JobListing.Title</td><td><span class="status">@application.Status.ToThai()</span></td><td>@application.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>
    }
    </tbody></table></div>
</section>
