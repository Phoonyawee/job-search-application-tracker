<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · CareerPilot</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="nav-wrap" aria-label="Main navigation">
            <a class="brand" asp-page="/Index"><span>CP</span>CareerPilot</a>
            <div class="nav-links">
                <a asp-page="/Index">แดชบอร์ด</a>
                @if (User.IsInRole("Candidate"))
                {
                    <a asp-page="/Jobs">ค้นหางาน</a>
                    <a asp-page="/Applications">ใบสมัครของฉัน</a>
                }
                @if (User.IsInRole("Recruiter") || User.IsInRole("Admin"))
                {
                    <a asp-page="/Recruiter">ฝ่ายสรรหา</a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a asp-page="/Admin">ผู้ดูแลระบบ</a>
                }
            </div>
            <partial name="_LoginPartial" />
        </nav>
    </header>
    <main class="page-shell">@RenderBody()</main>
    <footer><div class="page-shell">CareerPilot ระบบสาธิตสำหรับ Portfolio · ตำแหน่งงานและบริษัททั้งหมดเป็นข้อมูลสมมติ</div></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
